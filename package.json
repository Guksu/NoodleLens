{
  "name": "noodlelens",
  "version": "0.1.0",
  "private": true,
  "description": "웹페이지 요소를 골라 레이아웃·스타일 문제를 GPT·Claude에게 묻는 Chrome 사이드 패널 확장 프로그램",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.content.config.ts",
    "build:dev": "NODE_ENV=development vite build --mode development && NODE_ENV=development vite build -c vite.content.config.ts --mode development",
    "watch": "concurrently -k -n panel,content \"vite build --mode development --watch\" \"vite build -c vite.content.config.ts --mode development --watch\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:dev && vitest run -c vitest.e2e.config.ts",
    "demo": "node scripts/serve-demo.mjs",
    "eval": "tsx eval/run-eval.ts",
    "eval:check": "tsx eval/check-metrics.ts"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
